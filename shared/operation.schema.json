{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shared/operation.schema.json",
  "title": "Training Content Generator - Operation Record",
  "description": "操作記録 JSON の契約スキーマ（契約バージョン 1.0.0）",
  "type": "object",
  "required": ["schema_version", "title", "purpose", "target", "steps"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "教材名称"
    },
    "purpose": {
      "type": "string",
      "description": "学習目標・操作目的"
    },
    "target": {
      "type": "string",
      "description": "対象学習者"
    },
    "prerequisites": {
      "type": "string",
      "description": "事前準備（任意）"
    },
    "notes": {
      "type": "array",
      "description": "全体の注意事項（任意）",
      "items": { "type": "string" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "操作ステップ（1件以上）",
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["step_no", "title", "action", "target", "description"],
      "additionalProperties": false,
      "properties": {
        "step_no": {
          "type": "integer",
          "minimum": 1,
          "description": "ステップ番号（1起点の連番）"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "ステップタイトル"
        },
        "action": {
          "type": "string",
          "enum": ["click", "input", "select", "confirm", "navigate"],
          "description": "操作種別"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "操作対象（画面上の要素名）"
        },
        "input_value": {
          "type": "string",
          "description": "入力値（action=input の場合のみ・要脱敏）"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "操作説明（マニュアル本文・動画字幕にそのまま使用）"
        },
        "screenshot": {
          "type": "string",
          "pattern": "^step[0-9]{2,}\\.png$",
          "description": "スクリーンショットファイル名（省略可・欠落時は警告）"
        },
        "caution": {
          "type": "string",
          "description": "ステップ固有の注意事項（任意）"
        },
        "expected_result": {
          "type": "string",
          "description": "操作後の期待結果（任意）"
        }
      }
    }
  }
}
