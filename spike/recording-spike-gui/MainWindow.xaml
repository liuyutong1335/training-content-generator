<Window x:Class="RecordingSpikeGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="録画テスト (Spike A / 担当A)" Height="560" Width="640"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="デバイス選択" FontWeight="Bold" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="マイク:" Width="90" VerticalAlignment="Center"/>
                <ComboBox x:Name="MicBox" Width="420"/>
                <CheckBox x:Name="UseMic" Content="録る" IsChecked="True" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="システム音声:" Width="90" VerticalAlignment="Center"/>
                <ComboBox x:Name="SysBox" Width="420"/>
                <CheckBox x:Name="UseSys" Content="録る" IsChecked="True" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="StartBtn" Content="● 録画開始" Width="120" Height="36" Click="OnStart" FontSize="14"/>
            <Button x:Name="PauseBtn" Content="‖ 一時停止" Width="120" Height="36" Margin="8,0,0,0" IsEnabled="False" Click="OnPause"/>
            <Button x:Name="ResumeBtn" Content="▶ 再開" Width="100" Height="36" Margin="8,0,0,0" IsEnabled="False" Click="OnResume"/>
            <Button x:Name="StopBtn" Content="■ 停止" Width="100" Height="36" Margin="8,0,0,0" IsEnabled="False" Click="OnStop"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="待機中" Margin="0,0,0,8" FontWeight="Bold" Foreground="#0066CC"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="表示名（任意・省略可）: " VerticalAlignment="Center"/>
            <TextBox x:Name="TitleBox" Width="200" Text="テスト録画"/>
            <Button Content="フォルダを開く" Width="110" Margin="16,0,0,0" Click="OnOpenFolder"/>
        </StackPanel>

        <TextBox x:Name="Log" Grid.Row="4" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
    </Grid>
</Window>
