<Project Sdk="Microsoft.NET.Sdk">

  <!-- A (RecordingEngine) + B (OperationCaptureSession) の統合スモークテスト
       （B README「A との時間同期」推奨手順の実機検証 / duty-a-progress §5）
       使い方: dotnet run （プロジェクトとして spike/integration-smoke を指定）
       検証する項目（自動判定・約 12 秒で完了）:
         1. CaptureStarted 契機で session.Start() すると Event 0ms == MP4 0 秒になる
         2. Engine と Session の論理時間（Pause 除外）が一致する
         3. events.jsonl が契約どおりの形式で出力される（recording.started/stopped） -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TrainingContent.Capture\TrainingContent.Capture.csproj" />
    <ProjectReference Include="..\..\src\TrainingContent.EventCapture\TrainingContent.EventCapture.csproj" />
  </ItemGroup>

</Project>
