<Project Sdk="Microsoft.NET.Sdk">

  <!-- 担当D: WPF Application Shell。
       D1 では外枠とナビゲーションのみ。業務ロジックは持たない。
       第三者 UI Framework は意図的に導入しない（標準 WPF のみ）。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>TrainingContent.App</RootNamespace>
    <AssemblyName>TrainingContent.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrainingContent.Core\TrainingContent.Core.csproj" />
  </ItemGroup>

</Project>
