<Project Sdk="Microsoft.NET.Sdk">

  <!-- 担当D: WPF Application Shell。
       D1 では外枠とナビゲーションのみ。業務ロジックは持たない。
       第三者 UI Framework は意図的に導入しない（標準 WPF のみ）。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>TrainingContent.App</RootNamespace>
    <AssemblyName>TrainingContent.App</AssemblyName>
  </PropertyGroup>

  <!-- 依存方向: App → Storage / Capture / EventCapture / Video → Core。
       Storage / Capture / EventCapture / Video が UI を参照してはいけない。
       Capture は ScreenRecorderLib を直接参照するが、App はそれを知らない（境界は IRecordingEngine）。
       EventCapture の利用も OperationCaptureSession 経由に限る。
       Video の利用は IVideoComposer 経由に限る（Renderer 実装は App から生成しない）。 -->
  <ItemGroup>
    <ProjectReference Include="..\TrainingContent.Core\TrainingContent.Core.csproj" />
    <ProjectReference Include="..\TrainingContent.Storage\TrainingContent.Storage.csproj" />
    <ProjectReference Include="..\TrainingContent.Capture\TrainingContent.Capture.csproj" />
    <ProjectReference Include="..\TrainingContent.EventCapture\TrainingContent.EventCapture.csproj" />
    <ProjectReference Include="..\TrainingContent.Video\TrainingContent.Video.csproj" />
    <ProjectReference Include="..\TrainingContent.Screenshot\TrainingContent.Screenshot.csproj" />
    <ProjectReference Include="..\TrainingContent.Manual\TrainingContent.Manual.csproj" />
  </ItemGroup>

</Project>
