<Application x:Class="TrainingContent.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TrainingContent.App.Converters">
    <!-- StartupUri は使わない。ProjectStore を 1 instance だけ生成し、
         Composition Root（App.OnStartup）から MainWindow へ渡すため。 -->
    <Application.Resources>
        <!-- ナビゲーションで共有する最小限のブラシのみ。Theme System は作らない。 -->
        <SolidColorBrush x:Key="NavButtonHoverBrush" Color="#FFE8EEF7" />
        <SolidColorBrush x:Key="NavButtonActiveBrush" Color="#FFD6E2F5" />

        <!-- DataGridColumn は visual tree 外のため、Converter は Application スコープに置く -->
        <conv:DurationConverter x:Key="DurationConverter" />
        <conv:ArtifactStatusConverter x:Key="ArtifactStatusConverter" />
    </Application.Resources>
</Application>
