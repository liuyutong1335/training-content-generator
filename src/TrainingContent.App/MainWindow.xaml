<Window x:Class="TrainingContent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="研修コンテンツ作成ツール"
        Width="1100" Height="720"
        MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- ナビゲーション項目の見た目。D1 は標準 Button テンプレートのまま使う。 -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ===== Header ===== -->
        <Border DockPanel.Dock="Top" Background="#FF2B3A55" Padding="16,12">
            <TextBlock Text="研修コンテンツ作成ツール"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold" />
        </Border>

        <!-- ===== Status ===== -->
        <Border DockPanel.Dock="Bottom"
                Background="#FFF0F0F0"
                BorderBrush="#FFD0D0D0"
                BorderThickness="0,1,0,0"
                Padding="14,6">
            <TextBlock x:Name="StatusText" Text="" Foreground="#FF444444" />
        </Border>

        <!-- ===== Left Navigation ===== -->
        <Border DockPanel.Dock="Left"
                Width="196"
                Background="#FFF7F8FA"
                BorderBrush="#FFD0D0D0"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="8,12,8,8">
                <TextBlock Text="メニュー"
                           Foreground="#FF888888"
                           FontSize="11"
                           Margin="14,0,0,8" />

                <Button x:Name="NavHomeButton"
                        Content="ホーム"
                        Style="{StaticResource NavButtonStyle}"
                        Click="NavHome_Click" />
                <Button x:Name="NavRecordingButton"
                        Content="録画"
                        Style="{StaticResource NavButtonStyle}"
                        Click="NavRecording_Click" />
                <Button x:Name="NavReviewButton"
                        Content="手順確認"
                        Style="{StaticResource NavButtonStyle}"
                        Click="NavReview_Click" />
                <Button x:Name="NavContentsButton"
                        Content="コンテンツ管理"
                        Style="{StaticResource NavButtonStyle}"
                        Click="NavContents_Click" />
            </StackPanel>
        </Border>

        <!-- ===== Main Content ===== -->
        <ContentControl x:Name="PageHost" />

    </DockPanel>
</Window>
