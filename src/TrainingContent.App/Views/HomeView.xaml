<UserControl x:Class="TrainingContent.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="ホーム"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#FF1F2933" />

        <Border Grid.Row="1" Height="1" Background="#FFE0E0E0" Margin="0,12,0,20" />

        <Grid Grid.Row="2">

            <!-- ===== Current Project なし ===== -->
            <StackPanel x:Name="NoProjectPanel">
                <TextBlock Text="研修コンテンツ作成ツール"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#FF333333" />
                <TextBlock x:Name="NoProjectText"
                           Text="現在開いているプロジェクトはありません。"
                           Margin="0,14,0,0"
                           Foreground="#FF555555"
                           TextWrapping="Wrap" />
                <Button x:Name="NewProjectButton"
                        Content="新規プロジェクトを作成"
                        Width="208" Height="34"
                        HorizontalAlignment="Left"
                        Margin="0,20,0,0"
                        Click="NewProject_Click" />
                <TextBlock Text="コンテンツ管理から既存プロジェクトを開くこともできます。"
                           Margin="0,16,0,0"
                           Foreground="#FF888888"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- ===== Current Project あり ===== -->
            <ScrollViewer x:Name="ProjectPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>

                    <TextBlock Text="プロジェクト" FontSize="11" Foreground="#FF888888" />
                    <TextBlock x:Name="TitleText"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#FF1F2933"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />

                    <StackPanel x:Name="ObjectiveRow" Margin="0,20,0,0">
                        <TextBlock Text="目的" FontSize="11" Foreground="#FF888888" />
                        <TextBlock x:Name="ObjectiveText"
                                   Margin="0,3,0,0"
                                   Foreground="#FF333333"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="TargetAudienceRow" Margin="0,20,0,0">
                        <TextBlock Text="対象" FontSize="11" Foreground="#FF888888" />
                        <TextBlock x:Name="TargetAudienceText"
                                   Margin="0,3,0,0"
                                   Foreground="#FF333333"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="PrerequisitesRow" Margin="0,20,0,0">
                        <TextBlock Text="事前条件" FontSize="11" Foreground="#FF888888" />
                        <TextBlock x:Name="PrerequisitesText"
                                   Margin="0,3,0,0"
                                   Foreground="#FF333333"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <StackPanel Margin="0,0,48,0">
                            <TextBlock Text="手順数" FontSize="11" Foreground="#FF888888" />
                            <TextBlock x:Name="StepCountText" Margin="0,3,0,0" Foreground="#FF333333" />
                        </StackPanel>
                        <StackPanel Margin="0,0,48,0">
                            <TextBlock Text="録画" FontSize="11" Foreground="#FF888888" />
                            <TextBlock x:Name="RecordingText" Margin="0,3,0,0" Foreground="#FF333333" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="更新日時" FontSize="11" Foreground="#FF888888" />
                            <TextBlock x:Name="UpdatedText" Margin="0,3,0,0" Foreground="#FF333333" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
