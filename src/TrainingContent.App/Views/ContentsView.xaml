<UserControl x:Class="TrainingContent.App.Views.ContentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <DockPanel Grid.Row="0">
            <Button x:Name="RefreshButton"
                    DockPanel.Dock="Right"
                    Content="更新"
                    Width="88" Height="30"
                    VerticalAlignment="Center"
                    Click="Refresh_Click" />
            <Button x:Name="NewProjectButton"
                    DockPanel.Dock="Right"
                    Content="新規作成"
                    Width="104" Height="30"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Click="NewProject_Click" />
            <TextBlock Text="コンテンツ管理"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#FF1F2933"
                       VerticalAlignment="Center" />
        </DockPanel>

        <Border Grid.Row="1" Height="1" Background="#FFE0E0E0" Margin="0,12,0,16" />

        <!-- ===== List / Loading / Empty / Error ===== -->
        <Grid Grid.Row="2">

            <DataGrid x:Name="ProjectGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#FFEEEEEE"
                      BorderBrush="#FFD0D0D0"
                      BorderThickness="1"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#FFFAFBFC"
                      SelectionChanged="ProjectGrid_SelectionChanged">
                <DataGrid.RowStyle>
                    <!-- ダブルクリックで開く。行に紐づけて、ヘッダや空白のダブルクリックを拾わないようにする。 -->
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="MouseDoubleClick" Handler="ProjectRow_MouseDoubleClick" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="タイトル"
                                        Binding="{Binding Title}"
                                        Width="*" MinWidth="160" />
                    <DataGridTextColumn Header="更新日時"
                                        Binding="{Binding UpdatedAtUtc.LocalDateTime, StringFormat={}{0:yyyy/MM/dd HH:mm}}"
                                        Width="160" />
                    <DataGridTextColumn Header="録画時間"
                                        Binding="{Binding DurationMs, Converter={StaticResource DurationConverter}}"
                                        Width="100" />
                    <DataGridTextColumn Header="手順数"
                                        Binding="{Binding StepCount}"
                                        Width="70" />
                    <DataGridTextColumn Header="マニュアル"
                                        Binding="{Binding HasManual, Converter={StaticResource ArtifactStatusConverter}}"
                                        Width="90" />
                    <DataGridTextColumn Header="動画"
                                        Binding="{Binding HasVideo, Converter={StaticResource ArtifactStatusConverter}}"
                                        Width="90" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="LoadingText"
                       Text="読み込み中..."
                       Foreground="#FF666666"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />

            <StackPanel x:Name="EmptyPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock x:Name="EmptyText"
                           Text="保存済みのコンテンツはありません。"
                           Foreground="#FF666666"
                           HorizontalAlignment="Center" />
                <Button x:Name="EmptyNewProjectButton"
                        Content="新規プロジェクトを作成"
                        Width="208" Height="34"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        Click="NewProject_Click" />
            </StackPanel>

            <TextBlock x:Name="ErrorText"
                       Text="コンテンツの読み込みに失敗しました。"
                       Foreground="#FFC00000"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </Grid>

        <!-- ===== Actions ===== -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="OpenButton"
                    Content="開く"
                    Width="88" Height="30"
                    IsEnabled="False"
                    Click="Open_Click" />
            <Button x:Name="RenameButton"
                    Content="名前を変更"
                    Width="104" Height="30"
                    Margin="8,0,0,0"
                    IsEnabled="False"
                    Click="Rename_Click" />
            <Button x:Name="DeleteButton"
                    Content="削除"
                    Width="88" Height="30"
                    Margin="8,0,0,0"
                    IsEnabled="False"
                    Click="Delete_Click" />
        </StackPanel>

    </Grid>
</UserControl>
