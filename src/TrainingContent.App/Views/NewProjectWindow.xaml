<Window x:Class="TrainingContent.App.Views.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新規プロジェクト"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="13">
    <StackPanel Margin="18">

        <TextBlock Text="教材名（必須）" Foreground="#FF333333" />
        <TextBox x:Name="TitleTextBox" Margin="0,6,0,0" Padding="8,6" MaxLength="200" />
        <TextBlock x:Name="ValidationText"
                   Margin="0,6,0,0"
                   Foreground="#FFC00000"
                   Visibility="Collapsed" />

        <TextBlock Text="目的（任意）" Margin="0,14,0,0" Foreground="#FF333333" />
        <TextBox x:Name="ObjectiveTextBox" Margin="0,6,0,0" Padding="8,6" MaxLength="500" />

        <TextBlock Text="対象（任意）" Margin="0,14,0,0" Foreground="#FF333333" />
        <TextBox x:Name="TargetAudienceTextBox" Margin="0,6,0,0" Padding="8,6" MaxLength="200" />

        <TextBlock Text="事前条件（任意・1 行に 1 項目）" Margin="0,14,0,0" Foreground="#FF333333" />
        <TextBox x:Name="PrerequisitesTextBox"
                 Margin="0,6,0,0"
                 Padding="8,6"
                 Height="92"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Content="作成" Width="96" Height="30" IsDefault="True" Click="Ok_Click" />
            <Button x:Name="CancelButton" Content="キャンセル" Width="104" Height="30" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>

    </StackPanel>
</Window>
