<UserControl x:Class="TrainingContent.App.Views.RecordingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Recording"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#FF1F2933" />

        <Border Grid.Row="1" Height="1" Background="#FFE0E0E0" Margin="0,12,0,20" />

        <Grid Grid.Row="2">

            <!-- ===== Current Project なし ===== -->
            <StackPanel x:Name="NoProjectPanel">
                <TextBlock Text="録画 — プロジェクト未選択"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#FF333333" />
                <TextBlock x:Name="NoProjectText"
                           Text="録画を開始するには、先にプロジェクトを作成または開いてください。"
                           Margin="0,14,0,0"
                           Foreground="#FF555555"
                           TextWrapping="Wrap" />
                <TextBlock Text="プロジェクトの作成・オープンは Home または コンテンツ管理 から行えます。"
                           Margin="0,10,0,0"
                           Foreground="#FF888888"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- ===== Current Project あり ===== -->
            <ScrollViewer x:Name="RecordingPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>

                    <TextBlock Text="対象プロジェクト" FontSize="11" Foreground="#FF888888" />
                    <TextBlock x:Name="ProjectTitleText"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#FF1F2933"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />

                    <TextBlock Text="録画対象" FontSize="11" Foreground="#FF888888" Margin="0,22,0,0" />
                    <ComboBox x:Name="DisplayComboBox"
                              Width="360"
                              Height="28"
                              HorizontalAlignment="Left"
                              Margin="0,6,0,0"
                              DisplayMemberPath="Label" />

                    <TextBlock Text="システム音声" FontSize="11" Foreground="#FF888888" Margin="0,16,0,0" />
                    <ComboBox x:Name="SystemAudioComboBox"
                              Width="360"
                              Height="28"
                              HorizontalAlignment="Left"
                              Margin="0,6,0,0"
                              DisplayMemberPath="Label" />

                    <TextBlock Text="マイク" FontSize="11" Foreground="#FF888888" Margin="0,16,0,0" />
                    <ComboBox x:Name="MicrophoneComboBox"
                              Width="360"
                              Height="28"
                              HorizontalAlignment="Left"
                              Margin="0,6,0,0"
                              DisplayMemberPath="Label" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="RefreshDevicesButton"
                                Content="デバイス更新"
                                Width="120" Height="30"
                                Click="RefreshDevices_Click" />
                        <TextBlock x:Name="DevicesErrorText"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#FFC00000"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <Border Height="1" Background="#FFE0E0E0" Margin="0,22,0,18" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="状態" FontSize="11" Foreground="#FF888888" VerticalAlignment="Center" />
                        <TextBlock x:Name="StateText"
                                   Margin="12,0,0,0"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#FF1F2933"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="StartButton"
                                Content="録画開始"
                                Width="112" Height="34"
                                Click="Start_Click" />
                        <Button x:Name="PauseButton"
                                Content="一時停止"
                                Width="112" Height="34"
                                Margin="8,0,0,0"
                                Click="Pause_Click" />
                        <Button x:Name="ResumeButton"
                                Content="再開"
                                Width="112" Height="34"
                                Margin="8,0,0,0"
                                Click="Resume_Click" />
                        <Button x:Name="StopButton"
                                Content="停止"
                                Width="112" Height="34"
                                Margin="8,0,0,0"
                                Click="Stop_Click" />
                    </StackPanel>

                    <TextBlock x:Name="MessageText"
                               Margin="0,18,0,0"
                               Foreground="#FFC00000"
                               TextWrapping="Wrap" />

                    <TextBlock Text="録画ファイルは &lt;project&gt;\raw\recording.mp4 に保存されます。"
                               Margin="0,16,0,0"
                               FontSize="11"
                               Foreground="#FF999999"
                               TextWrapping="Wrap" />

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
