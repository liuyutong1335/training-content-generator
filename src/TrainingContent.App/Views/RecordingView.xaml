<UserControl x:Class="TrainingContent.App.Views.RecordingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Recording"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#FF1F2933" />

        <Border Grid.Row="1" Height="1" Background="#FFE0E0E0" Margin="0,12,0,20" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="Recording — 未実装"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#FF333333" />
            <TextBlock Text="録画の開始・一時停止・再開・停止を操作する画面です。"
                       Margin="0,10,0,0"
                       Foreground="#FF555555"
                       TextWrapping="Wrap" />
            <TextBlock Text="D5 で実装します（録画エンジン本体は担当Aの IRecordingEngine を利用）。"
                       Margin="0,6,0,0"
                       Foreground="#FF888888"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
