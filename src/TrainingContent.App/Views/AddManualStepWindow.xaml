<Window x:Class="TrainingContent.App.Views.AddManualStepWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手順の追加"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="13">
    <StackPanel Margin="18">

        <TextBlock Text="追加する手順のタイトルを入力してください。" Foreground="#FF333333" />

        <TextBlock Text="手順タイトル" Foreground="#FF888888" Margin="0,12,0,0" />
        <TextBox x:Name="TitleTextBox"
                 Margin="0,4,0,0"
                 Padding="8,6"
                 MaxLength="200" />

        <TextBlock x:Name="ValidationText"
                   Margin="0,6,0,0"
                   Foreground="#FFC00000"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton"
                    Content="追加"
                    Width="92" Height="30"
                    IsDefault="True"
                    Click="Ok_Click" />
            <Button x:Name="CancelButton"
                    Content="キャンセル"
                    Width="104" Height="30"
                    Margin="8,0,0,0"
                    IsCancel="True" />
        </StackPanel>

    </StackPanel>
</Window>
