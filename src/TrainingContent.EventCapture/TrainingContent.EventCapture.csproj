<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- UseWPF: UI Automation (System.Windows.Automation) / UseWindowsForms: メッセージループと SystemInformation -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- LibraryImport (source generated P/Invoke) に必要 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- OperationCaptureSession のスレッド後片付けを検証するテスト用（D5-B 統合テスト指摘対応） -->
    <InternalsVisibleTo Include="TrainingContent.EventCapture.Tests" />
  </ItemGroup>

</Project>
